# SpendGuard environment — copy to .env and fill in. NEVER commit a filled .env.
# All values are placeholders; the app reads them only from the environment.

# Channel3 catalog key (US-only catalog; app "SpendGuard" on trychannel3.com)
CHANNEL3_API_KEY=

# PayPal sandbox REST app credentials (developer.paypal.com, Sandbox section)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox base URL (default is correct; never point this at the live host for the demo)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Groq LLM key (deploy path). If unset on deploy, /compare uses a deterministic
# template comparison and reports llm_used=false — never fake AI text.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
GROQ_MODEL=
